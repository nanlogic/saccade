{
  "manifest_version": 3,
  "name": "Saccade Extension (Development)",
  "description": "Authorized closed-loop observation and native-input bridge for Saccade.",
  "version": "0.3.13",
  "key": "",
  "minimum_chrome_version": "120",
  "action": { "default_title": "Saccade", "default_popup": "popup.html" },
  "background": { "service_worker": "src/service_worker.js" },
  "host_permissions": ["http://*/*", "https://*/*"],
  "permissions": ["tabs", "nativeMessaging", "scripting", "storage"]
}
