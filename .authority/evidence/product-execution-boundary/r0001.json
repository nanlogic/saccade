      "sources": [
        "S-001"
      ],
      "reason": "Explicit owner-approved source.",
      "confidence": "high",
      "text": "The production route is Extension → Native Messaging Host → owner-only local IPC → MCP."
    },
    {
      "item": "R-003",
      "change": "selected",
      "sources": [
        "S-001"
      ],
      "reason": "Explicit owner-approved source.",
      "confidence": "high",
      "text": "Registry-approved, object-addressed `saccade.act` software execution is the preferred bounded action path when the target exposes a supported affordance."
    },
    {
      "item": "R-004",
      "change": "selected",
      "sources": [
        "S-001"
      ],
      "reason": "Explicit owner-approved source.",
      "confidence": "high",
      "text": "The Agent client's own same-tab execution is the fallback when bounded software execution is unavailable, rejected, or cannot verify the requested transition."
    },
    {
      "item": "R-005",
      "change": "selected",
      "sources": [
        "S-001"
      ],
      "reason": "Explicit owner-approved source.",
      "confidence": "high",
      "text": "Playwright, CDP, screenshots, selectors, and arbitrary coordinates are not product fallback routes."
    },
    {
      "item": "R-006",
      "change": "selected",
      "sources": [
        "S-001"
      ],
      "reason": "Explicit owner-approved source.",
      "confidence": "high",
      "text": "The optional Reference Actuator remains development-only and is not a default product dependency."
    },
    {
      "item": "R-007",
      "change": "selected",
      "sources": [
        "S-001"
      ],
      "reason": "Explicit owner-approved source.",
      "confidence": "high",
      "text": "Software execution never receives arbitrary coordinates, DOM locators, or protected values; it binds the object, document, and revision and must report verified, accepted-but-unverified, or explicit handoff truthfully."
    }
