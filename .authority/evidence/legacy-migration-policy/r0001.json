  "changes": [
    {
      "item": "R-001",
      "change": "selected",
      "sources": [
        "S-001"
      ],
      "reason": "The migration manifest and component records consistently require reviewed, component-by-component migration from the private legacy archive with provenance, tests, and explicit release limitations. Component migration notes are evidence of bounded imports, not independent product authority.",
      "confidence": "high",
      "text": "Use the private `nanlogic/saccade-legacy` archive only as a reviewed source."
    },
    {
      "item": "R-002",
      "change": "selected",
      "sources": [
        "S-001"
      ],
      "reason": "The migration manifest and component records consistently require reviewed, component-by-component migration from the private legacy archive with provenance, tests, and explicit release limitations. Component migration notes are evidence of bounded imports, not independent product authority.",
      "confidence": "high",
      "text": "Migrate one approved component at a time; never copy the legacy tree or revive monolithic classifiers."
    },
    {
      "item": "R-003",
      "change": "selected",
      "sources": [
        "S-001"
      ],
      "reason": "The migration manifest and component records consistently require reviewed, component-by-component migration from the private legacy archive with provenance, tests, and explicit release limitations. Component migration notes are evidence of bounded imports, not independent product authority.",
      "confidence": "high",
      "text": "Every migrated component records its source commit and path, preserves or replaces its focused tests, and retains truthful limitations."
    },
    {
      "item": "R-004",
      "change": "selected",
      "sources": [
        "S-001"
      ],
      "reason": "The migration manifest and component records consistently require reviewed, component-by-component migration from the private legacy archive with provenance, tests, and explicit release limitations. Component migration notes are evidence of bounded imports, not independent product authority.",
      "confidence": "high",
      "text": "A migration record proves the bounded provenance of that component; it does not independently promote Catalog or public release status."
    },
    {
      "item": "R-005",
      "change": "selected",
      "sources": [
        "S-001"
      ],
      "reason": "The migration manifest and component records consistently require reviewed, component-by-component migration from the private legacy archive with provenance, tests, and explicit release limitations. Component migration notes are evidence of bounded imports, not independent product authority.",
      "confidence": "high",
      "text": "Public status still requires the current release candidate's browser and evidence gates."
    }
  ],
