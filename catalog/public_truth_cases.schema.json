{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saccade.local/schemas/public-truth-cases.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_from", "source_documents", "outcomes", "summary", "items"],
  "properties": {
    "schema": { "const": "saccade.public-truth-cases/1" },
    "generated_from": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 }
    },
    "source_documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "reason"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["merged", "blocked"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "outcomes": {
      "const": ["pass", "truthful_limitation", "unsupported", "blocked"]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles", "variants", "boundaries", "lifecycle_scenarios", "total"],
      "properties": {
        "roles": { "const": 34 },
        "variants": { "const": 12 },
        "boundaries": { "const": 6 },
        "lifecycle_scenarios": { "type": "integer", "minimum": 1 },
        "total": { "type": "integer", "minimum": 53 }
      }
    },
    "items": {
      "type": "array",
      "minItems": 53,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "kind", "target", "classification", "sources",
          "implementations", "expected_initial", "expected_transition",
          "expected_limitation", "browsers", "pass_criteria", "outcome",
          "reason"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z_]+:[a-z0-9_]+$" },
          "kind": { "enum": ["role", "variant", "boundary", "lifecycle"] },
          "target": { "type": "string", "minLength": 1 },
          "classification": {
            "enum": [
              "mainstream_control", "uncommon_control", "semantic_object",
              "truthful_boundary", "lifecycle"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "url", "status"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "pattern": "^https://" },
                "status": {
                  "enum": [
                    "primary_standard", "official_implementation_guidance",
                    "historical_reference_only", "candidate", "active_core"
                  ]
                }
              }
            }
          },
          "implementations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "expected_initial": { "type": "string", "minLength": 1 },
          "expected_transition": { "type": "string", "minLength": 1 },
          "expected_limitation": { "type": "string" },
          "browsers": { "const": ["chrome", "edge"] },
          "pass_criteria": { "type": "string", "minLength": 1 },
          "outcome": { "enum": ["pass", "truthful_limitation", "unsupported", "blocked"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
