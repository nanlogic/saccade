      "url": "https://www.w3.org/WAI/ARIA/apg/patterns/menubar/examples/menubar-navigation/",
      "goal": "Expand About.",
      "target": { "role": "menu_item", "name": "About" },
      "action": { "operation": "click" },
      "postcondition": { "state": "expanded", "equals": "true" }
    }
  ],
  "required_source_families": [
    { "source": "Selenium", "implementation": "native_html", "status": "active" },
